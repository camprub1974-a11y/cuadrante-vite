    "objetos_numerados": { "label": "Objetos Numerados (con Nº de Serie/IMEI)", "type": "repeater", "itemLabel": "Objeto Numerado", "itemFields": [{ "id": "objeto", "label": "Objeto", "type": "select", "options": ["ACCESORIOS FOTOGRAFICOS", "ALTAVOZ", "AMPLIADORA FOTOGRAFICA", "ASPIRADORA", "BATIDORA", "CADENA MUSICAL", "CALCULADORA", "CAMARA DE CINE", "CAMARA DE VIDEO", "CAMARA FOTOGRAFICA", "CINTA DE CASETE", "CINTA DE VIDEO", "COMPACT DISC DE DATOS (CD ROM)", "COMPACT DISC MUSICAL", "CONGELADOR", "DISQUETE", "DVD", "EMISORA DE RADIO", "FAX", "FOTOCOPIADORA", "FRIGORIFICO", "HORNO ELECTRICO", "IMPRESORA", "LAVADORA", "LAVAVAJILLAS", "LIBRO ELECTRONICO", "LICUADORA", "MAQUINA DE ESCRIBIR", "MAQUINA DE ESCRIBIR ELECTRICA", "MAQUINA REGISTRADORA", "MICROONDAS", "MICROONDAS DE MESA", "MICROPROCESADOR", "MODEM", "MONITOR DE PC", "NAVEGADOR", "OBJETIVO FOTOGRAFICO", "ORDENADOR PERSONAL", "ORDENADOR PORTATIL", "PANTALLA DE PROYECCION", "PELICULA FOTOGRAFICA", "PLANCHA ELECTRICA", "PROYECTOR DE CINE", "PROYECTOR DE DIAPOSITIVAS", "RADIOCASETE", "RADIOCASETE PORTATIL", "RECEPTOR DE RADIO", "RECEPTOR DE RADIO PORTATIL", "REPRODUCTOR DE COMPACT DISC MUSICAL", "REPRODUCTOR DE COMPACT DISC MUSICAL PORTATIL", "REPRODUCTOR DE DISCOS DE VINILO", "REPRODUCTOR DE VIDEO", "REPRODUCTOR MAGNETOFONICO", "REVELADORA FOTOGRAFICA", "ROBOT DE COCINA", "SCANNER", "SOFTWARE", "TABLET", "TARJETA DE SONIDO", "TARJETA GRAFICA", "TECLADO", "TELEFONO MOVIL", "TELETIPO", "TELEVISOR", "TELEVISOR PORTATIL", "UNIDAD CENTRAL (CPU)", "UNIDAD DE CD ROM", "UNIDAD DE CINTA", "UNIDAD DE DISCO DURO", "UNIDAD DE DISQUETE", "VAPORETA", "VIDEOCONSOLA", "VIDEOJUEGO"] }, { "id": "marca", "label": "Marca", "type": "text" }, { "id": "num_serie", "label": "Número de Serie / IMEI", "type": "text" }, { "id": "valor", "label": "Valor (€)", "type": "number" }] },
    "otros_objetos": { "label": "Otros Objetos (sin Nº de Serie)", "type": "repeater", "itemLabel": "Otro Objeto", "itemFields": [{ "id": "objeto", "label": "Objeto", "type": "select", "options": ["ACCESORIOS AUTOMOVIL", "ANIMALES", "BALANZA DE PRECISIÓN", "BASES DE DATOS", "BEBIDAS", "BOLSO", "CDS/DVS/ANÁLOGOS GRABADOS", "CDS/DVS/ANÁLOGOS VÍRGENES", "CALZADO", "CAMARAS DE VIDEO", "CAMARAS FOTOGRAFICAS", "CARTERA", "CHATARRA", "COBRE", "COMBUSTIBLES", "COMESTIBLES", "COMPLEMENTOS", "COSMETICOS", "DINERO", "DOCUMENTOS", "ELECTRODOMESTICOS/DE VIDEO Y F", "ELEMENTOS DE VALOR HISTORICO", "EQUIPO DE SONIDO/MUSICA DE VEH", "EQUIPOS REPROGRAFICOS/FOTOCOPI", "EQUIPOS DE AUDIO Y MUSICA (EXC", "FARMACOS", "FICHEROS CONTENIDOS EN INTERNE", "FICHEROS CONTENIDOS EN PC", "FOTOCOPIAS O RÉPLICAS DE CARÁT", "GAFAS", "HARDWARE/EQUIPO INFORMÁTICO", "HERRAMIENTAS", "INMUEBLES", "JUGUETES", "LIBROS/ENCICLOPEDIAS", "LLAVES", "MANDO A DISTANCIA DE ACCESO A", "MAQUINARIA AGRÍCOLA", "MAQUINARIA PESADA", "MARROQUINERIA", "MASA ARBÓREA", "MATERIALES CONDUCTORES(DISTINT", "MEDICAMENTOS", "MOBILIARIO URBANO", "NAVEGADORES-GPS", "OTRO MOBILIARIO DOMÉSTICO", "OTRO OBJETO", "OTRO TIPO DE MAQUINARIA", "OTROS DISPOSITIVOS DE ALMACENA", "OTROS EFECTOS PERSONALES", "OTROS PRODUCTOS QUIMICOS", "PANEL FOTOVOLTAICO (PLACAS SOL", "PERFUMERIA", "PRODUCTOS HORTOFRUTÍCOLAS", "PUNTERO LÁSER", "REDES DE COMUNICACIÓN", "RESTO DE TARJETAS ELECTRÓNICAS", "SERVIDORES DE RED", "SOFTWARE/PROGRAMAS INFORMATICO", "TABACO", "TARJETAS DE CRÉDITO/DÉBITO/BAN", "TELEFONO MOVIL", "TEXTIL/ROPA"] }, { "id": "cantidad", "label": "Cantidad", "type": "number" }, { "id": "valor", "label": "Valor (€)", "type": "number" }] },
